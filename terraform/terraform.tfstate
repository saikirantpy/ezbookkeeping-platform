                "iops": 3000,
                "kms_key_id": "arn:aws:kms:ap-south-1:356627769772:key/e3bdfb4b-4f22-4e9d-980e-92fcfb323f8c",
                "tags": {},
                "tags_all": {},
                "throughput": 125,
                "volume_id": "vol-08739f56150276da5",
